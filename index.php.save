<script>
// ============================================================
//  STATE
// ============================================================
const state = {
    tool:          'select',   // 'select' | 'pan'
    images:        [],         // { id, src, name }
    canvasItems:   [],         // { id, imgId, x, y, w, h, rot, opacity, z }
    selected:      null,       // canvas item id
    pan:           { x: 0, y: 0 },
    zoom:          1,
    zCounter:      1,
    idCounter:     0,
};

// DOM refs
const canvasWrap   = document.getElementById('canvasWrap');
const surface      = document.getElementById('canvas-surface');
const dropHint     = document.getElementById('dropHint');
const zoomBadge    = document.getElementById('zoomBadge');
const imageStrip   = document.getElementById('imageStrip');
const propPanel    = document.getElementById('propPanel');
const dragGhost    = document.getElementById('dragGhost');
const ctxMenu      = document.getElementById('ctxMenu');

// ============================================================
//  UTILITIES
// ============================================================
const uid = () => ++state.idCounter;

function applyTransform() {
    surface.style.transform =
        `translate(${state.pan.x}px, ${state.pan.y}px) scale(${state.zoom})`;
    zoomBadge.textContent = Math.round(state.zoom * 100) + '%';
}

function canvasCoords(clientX, clientY) {
    const rect = canvasWrap.getBoundingClientRect();
    return {
        x: (clientX - rect.left - state.pan.x) / state.zoom,
        y: (clientY - rect.top  - state.pan.y) / state.zoom,
    };
}

function setTool(t) {
    state.tool = t;
    document.getElementById('toolSelect').classList.toggle('active', t === 'select');
    document.getElementById('toolPan').classList.toggle('active', t === 'pan');
    canvasWrap.style.cursor = t === 'pan' ? 'grab' : 'default';
}

// ============================================================
//  IMAGE LIBRARY
// ============================================================
function addImageToLibrary(src, name) {
    const img = { id: uid(), src, name };
    state.images.push(img);
    renderThumb(img);
    updateDropHint();
}

function renderThumb(img) {
    const wrap = document.createElement('div');
    wrap.className  = 'thumb-item';
    wrap.draggable  = true;
    wrap.dataset.id = img.id;
    wrap.title      = img.name;

    const el = document.createElement('img');
    el.src = img.src;
    el.alt = img.name;

    const del = document.createElement('button');
    del.className = 'thumb-delete';
    del.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/>
    </svg>`;
    del.title = 'Remove from library';
    del.addEventListener('click', (e) => { e.stopPropagation(); removeFromLibrary(img.id); });

    wrap.appendChild(el);
    wrap.appendChild(del);
    imageStrip.appendChild(wrap);

    // Drag from sidebar
    wrap.addEventListener('dragstart', (e) => {
        e.dataTransfer.setData('imgId', img.id);
        e.dataTransfer.effectAllowed = 'copy';
        dragGhost.src = img.src;
        dragGhost.style.width = '100px';
        dragGhost.style.display = 'block';
        e.dataTransfer.setDragImage(dragGhost, 50, 50);
        setTimeout(() => { dragGhost.style.display = 'none'; }, 0);
    });
}

function removeFromLibrary(imgId) {
    state.images = state.images.filter(i => i.id !== imgId);
    imageStrip.querySelector(`[data-id="${imgId}"]`)?.remove();
    updateDropHint();
}

// ============================================================
//  CANVAS ITEMS
// ============================================================
function placeImage(imgId, cx, cy) {
    const img = state.images.find(i => i.id === imgId);
    if (!img) return;

    const item = {
        id: uid(), imgId,
        x: cx - 120, y: cy - 90,
        w: 240, h: 180,
        opacity: 1, z: state.zCounter++,
    };
    state.canvasItems.push(item);
    renderCanvasItem(item);
    selectItem(item.id);
    updateDropHint();
}

function renderCanvasItem(item) {
    const img = state.images.find(i => i.id === item.imgId);
    if (!img) return;

    const el = document.createElement('div');
    el.className    = 'canvas-item';
    el.dataset.id   = item.id;

    const imgEl = document.createElement('img');
    imgEl.src = img.src;
    imgEl.alt = img.name;
    el.appendChild(imgEl);

    // Resize handles
    ['nw','ne','se','sw'].forEach(dir => {
        const h = document.createElement('div');
        h.className = `resize-handle ${dir}`;
        h.dataset.dir = dir;
        el.appendChild(h);
    });

    surface.appendChild(el);
    syncItemStyle(item);
    attachItemEvents(el, item);
}

function syncItemStyle(item) {
    const el = surface.querySelector(`[data-id="${item.id}"]`);
    if (!el) return;
    el.style.left    = item.x + 'px';
    el.style.top     = item.y + 'px';
    el.style.width   = item.w + 'px';
    el.style.height  = item.h + 'px';
    el.style.opacity = item.opacity;
    el.style.zIndex  = item.z;
}

function removeCanvasItem(id) {
    state.canvasItems = state.canvasItems.filter(i => i.id !== id);
    surface.querySelector(`[data-id="${id}"]`)?.remove();
    if (state.selected === id) { state.selected = null; renderProps(); }
    updateDropHint();
}

function duplicateItem(id) {
    const src = state.canvasItems.find(i => i.id === id);
    if (!src) return;
    const copy = { ...src, id: uid(), x: src.x + 24, y: src.y + 24, z: state.zCounter++ };
    state.canvasItems.push(copy);
    renderCanvasItem(copy);
    selectItem(copy.id);
}

// ============================================================
//  SELECTION
// ============================================================
function selectItem(id) {
    state.selected = id;
    surface.querySelectorAll('.canvas-item').forEach(el => {
        el.classList.toggle('selected', el.dataset.id == id);
    });
    renderProps();
}

function deselectAll() {
    state.selected = null;
    surface.querySelectorAll('.canvas-item').forEach(el => el.classList.remove('selected'));
    renderProps();
}

// ============================================================
//  DRAG-MOVE & RESIZE
// ============================================================
function attachItemEvents(el, item) {
    // Click to select
    el.addEventListener('pointerdown', (e) => {
        if (state.tool !== 'select') return;
        if (e.target.classList.contains('resize-handle')) return;
        e.stopPropagation();
        selectItem(item.id);
        startDragMove(e, item);
    });

    // Resize handles
    el.querySelectorAll('.resize-handle').forEach(h => {
        h.addEventListener('pointerdown', (e) => {
            e.stopPropagation();
            selectItem(item.id);
            startResize(e, item, h.dataset.dir);
        });
    });

    // Context menu
    el.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        selectItem(item.id);
        showCtxMenu(e.clientX, e.clientY);
    });
}

function startDragMove(e, item) {
    const startX = e.clientX, startY = e.clientY;
    const origX  = item.x,    origY  = item.y;

    const el = surface.querySelector(`[data-id="${item.id}"]`);
    el.style.transition = 'none';

    const onMove = (ev) => {
        item.x = origX + (ev.clientX - startX) / state.zoom;
        item.y = origY + (ev.clientY - startY) / state.zoom;
        syncItemStyle(item);
        if (state.selected === item.id) syncPropsFields(item);
    };

    const onUp = () => {
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup',   onUp);
    };

    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup',   onUp);
}

function startResize(e, item, dir) {
    const startX = e.clientX, startY = e.clientY;
    const orig   = { x: item.x, y: item.y, w: item.w, h: item.h };

    const onMove = (ev) => {
        const dx = (ev.clientX - startX) / state.zoom;
        const dy = (ev.clientY - startY) / state.zoom;

        if (dir.includes('e')) item.w = Math.max(40, orig.w + dx);
        if (dir.includes('s')) item.h = Math.max(40, orig.h + dy);
        if (dir.includes('w')) { item.w = Math.max(40, orig.w - dx); item.x = orig.x + orig.w - item.w; }
        if (dir.includes('n')) { item.h = Math.max(40, orig.h - dy); item.y = orig.y + orig.h - item.h; }

        syncItemStyle(item);
        if (state.selected === item.id) syncPropsFields(item);
    };

    const onUp = () => {
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup',   onUp);
    };

    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup',   onUp);
}

// ============================================================
//  PAN & ZOOM
// ============================================================
let isPanning = false, panStart = {};

canvasWrap.addEventListener('pointerdown', (e) => {
    if (state.tool === 'pan' || e.button === 1) {
        isPanning = true;
        panStart  = { x: e.clientX - state.pan.x, y: e.clientY - state.pan.y };
        canvasWrap.style.cursor = 'grabbing';
        e.preventDefault();
    } else {
        deselectAll();
        hideCtxMenu();
    }
});

window.addEventListener('pointermove', (e) => {
    if (!isPanning) return;
    state.pan.x = e.clientX - panStart.x;
    state.pan.y = e.clientY - panStart.y;
    applyTransform();
});

window.addEventListener('pointerup', () => {
    if (isPanning) {
        isPanning = false;
        canvasWrap.style.cursor = state.tool === 'pan' ? 'grab' : 'default';
    }
});

canvasWrap.addEventListener('wheel', (e) => {
    e.preventDefault();
    const rect   = canvasWrap.getBoundingClientRect();
    const mouseX = e.clientX - rect.left;
    const mouseY = e.clientY - rect.top;
    const delta  = e.deltaY < 0 ? 1.1 : 0.9;
    const newZ   = Math.max(0.1, Math.min(5, state.zoom * delta));

    state.pan.x = mouseX - (mouseX - state.pan.x) * (newZ / state.zoom);
    state.pan.y = mouseY - (mouseY - state.pan.y) * (newZ / state.zoom);
    state.zoom  = newZ;
    applyTransform();
}, { passive: false });

// Zoom buttons
document.getElementById('toolZoomIn').addEventListener('click',  () => adjustZoom(1.2));
document.getElementById('toolZoomOut').addEventListener('click', () => adjustZoom(0.8));
document.getElementById('toolZoomFit').addEventListener('click', resetView);

function adjustZoom(factor) {
    const rect = canvasWrap.getBoundingClientRect();
    const cx = rect.width / 2, cy = rect.height / 2;
    const newZ = Math.max(0.1, Math.min(5, state.zoom * factor));
    state.pan.x = cx - (cx - state.pan.x) * (newZ / state.zoom);
    state.pan.y = cy - (cy - state.pan.y) * (newZ / state.zoom);
    state.zoom  = newZ;
    applyTransform();
}

function resetView() {
    state.pan  = { x: 0, y: 0 };
    state.zoom = 1;
    applyTransform();
}

// ============================================================
//  DROP — from filesystem onto canvas
// ============================================================
canvasWrap.addEventListener('dragover',  (e) => { e.preventDefault(); canvasWrap.classList.add('drop-active'); });
canvasWrap.addEventListener('dragleave', (e) => {
    if (!canvasWrap.contains(e.relatedTarget)) canvasWrap.classList.remove('drop-active');
});

canvasWrap.addEventListener('drop', (e) => {
    e.preventDefault();
    canvasWrap.classList.remove('drop-active');
    hideCtxMenu();

    const imgId = e.dataTransfer.getData('imgId');
    const coords = canvasCoords(e.clientX, e.clientY);

    if (imgId) {
        // Drag from sidebar thumbnail
        placeImage(parseInt(imgId), coords.x, coords.y);
    } else if (e.dataTransfer.files.length) {
        // Drag from OS file system
        [...e.dataTransfer.files].forEach(file => {
            if (!file.type.startsWith('image/')) return;
            const reader = new FileReader();
            reader.onload = (ev) => {
                addImageToLibrary(ev.target.result, file.name);
                const img = state.images[state.images.length - 1];
                placeImage(img.id, coords.x, coords.y);
            };
            reader.readAsDataURL(file);
        });
    }
});

// ============================================================
//  FILE INPUT (sidebar upload zone + toolbar button)
// ============================================================
function handleFiles(files) {
    [...files].forEach(file => {
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = (ev) => addImageToLibrary(ev.target.result, file.name);
        reader.readAsDataURL(file);
    });
}

document.getElementById('fileInput').addEventListener('change',    (e) => handleFiles(e.target.files));
document.getElementById('quickUpload').addEventListener('change',  (e) => handleFiles(e.target.files));

const uploadZone = document.getElementById('uploadZone');
uploadZone.addEventListener('dragover',  (e) => { e.preventDefault(); uploadZone.classList.add('drag-over'); });
uploadZone.addEventListener('dragleave', ()  => uploadZone.classList.remove('drag-over'));
uploadZone.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.classList.remove('drag-over');
    handleFiles(e.dataTransfer.files);
});

// ============================================================
//  PROPERTIES PANEL
// ============================================================
function renderProps() {
    const item = state.canvasItems.find(i => i.id === state.selected);
    if (!item) {
        propPanel.innerHTML = `
            <div class="no-selection">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2z"/>
                </svg>
                Select an image on the canvas to edit its properties
            </div>`;
        return;
    }

    propPanel.innerHTML = `
        <div class="prop-panel">
            <div class="prop-row">
                <div class="prop-label">Position</div>
                <div class="prop-row-inline">
                    <div class="prop-field">
                        <label class="prop-label" for="pX">X</label>
                        <input class="prop-input" id="pX" type="number" value="${Math.round(item.x)}">
                    </div>
                    <div class="prop-field">
                        <label class="prop-label" for="pY">Y</label>
                        <input class="prop-input" id="pY" type="number" value="${Math.round(item.y)}">
                    </div>
                </div>
            </div>
            <div class="prop-row">
                <div class="prop-label">Size</div>
                <div class="prop-row-inline">
                    <div class="prop-field">
                        <label class="prop-label" for="pW">W</label>
                        <input class="prop-input" id="pW" type="number" min="10" value="${Math.round(item.w)}">
                    </div>
                    <div class="prop-field">
                        <label class="prop-label" for="pH">H</label>
                        <input class="prop-input" id="pH" type="number" min="10" value="${Math.round(item.h)}">
                    </div>
                </div>
            </div>
            <div class="prop-row">
                <div class="prop-label">Opacity — ${Math.round(item.opacity * 100)}%</div>
                <input type="range" id="pOpacity" min="0" max="1" step="0.01" value="${item.opacity}">
            </div>
            <div class="prop-row">
                <button class="prop-btn" id="pDupe">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    Duplicate
                </button>
                <button class="prop-btn danger" id="pDel" style="margin-top:6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Delete
                </button>
            </div>
        </div>`;

    // Bind prop inputs
    const bind = (id, fn) => document.getElementById(id)?.addEventListener('input', fn);

    bind('pX', (e) => { item.x = parseFloat(e.target.value)||0; syncItemStyle(item); });
    bind('pY', (e) => { item.y = parseFloat(e.target.value)||0; syncItemStyle(item); });
    bind('pW', (e) => { item.w = Math.max(10, parseFloat(e.target.value)||10); syncItemStyle(item); });
    bind('pH', (e) => { item.h = Math.max(10, parseFloat(e.target.value)||10); syncItemStyle(item); });
    bind('pOpacity', (e) => {
        item.opacity = parseFloat(e.target.value);
        syncItemStyle(item);
        document.querySelector('.prop-row .prop-label').textContent =
            `Opacity — ${Math.round(item.opacity*100)}%`;
    });

    document.getElementById('pDupe')?.addEventListener('click', () => duplicateItem(item.id));
    document.getElementById('pDel')?.addEventListener('click',  () => removeCanvasItem(item.id));
}

function syncPropsFields(item) {
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = Math.round(v); };
    set('pX', item.x); set('pY', item.y); set('pW', item.w); set('pH', item.h);
}

// ============================================================
//  CONTEXT MENU
// ============================================================
function showCtxMenu(cx, cy) {
    ctxMenu.style.left = cx + 'px';
    ctxMenu.style.top  = cy + 'px';
    ctxMenu.classList.add('open');
}
function hideCtxMenu() { ctxMenu.classList.remove('open'); }

document.getElementById('ctxBringFront').addEventListener('click', () => {
    const item = state.canvasItems.find(i => i.id === state.selected);
    if (item) { item.z = state.zCounter++; syncItemStyle(item); }
    hideCtxMenu();
});
document.getElementById('ctxSendBack').addEventListener('click', () => {
    const item = state.canvasItems.find(i => i.id === state.selected);
    if (item) { item.z = 0; syncItemStyle(item); }
    hideCtxMenu();
});
document.getElementById('ctxDuplicate').addEventListener('click', () => {
    if (state.selected) duplicateItem(state.selected);
    hideCtxMenu();
});
document.getElementById('ctxDelete').addEventListener('click', () => {
    if (state.selected) removeCanvasItem(state.selected);
    hideCtxMenu();
});

document.addEventListener('click',       hideCtxMenu);
document.addEventListener('contextmenu', (e) => { if (!e.target.closest('.canvas-item')) hideCtxMenu(); });

// ============================================================
//  TOOLBAR BUTTONS
// ============================================================
document.getElementById('toolSelect').addEventListener('click', () => setTool('select'));
document.getElementById('toolPan').addEventListener('click',    () => setTool('pan'));
document.getElementById('toolClearAll').addEventListener('click', () => {
    if (!state.canvasItems.length) return;
    if (confirm('Clear all items from the canvas?')) {
        state.canvasItems.forEach(i => surface.querySelector(`[data-id="${i.id}"]`)?.remove());
        state.canvasItems = [];
        state.selected    = null;
        renderProps();
        updateDropHint();
    }
});

// ============================================================
//  KEYBOARD SHORTCUTS
// ============================================================
document.addEventListener('keydown', (e) => {
    const tag = document.activeElement.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;

    if (e.key === 'v' || e.key === 'V') setTool('select');
    if (e.key === 'h' || e.key === 'H') setTool('pan');
    if (e.key === '0') resetView();
    if (e.key === '+' || e.key === '=') adjustZoom(1.2);
    if (e.key === '-') adjustZoom(0.8);

    if ((e.key === 'Delete' || e.key === 'Backspace') && state.selected) {
        removeCanvasItem(state.selected);
    }
    if ((e.key === 'd' || e.key === 'D') && (e.ctrlKey || e.metaKey) && state.selected) {
        e.preventDefault();
        duplicateItem(state.selected);
    }
    if (e.key === 'Escape') { deselectAll(); hideCtxMenu(); }
});

// ============================================================
//  DROP HINT
// ============================================================
function updateDropHint() {
    const hasItems = state.canvasItems.length > 0;
    dropHint.classList.toggle('hidden', hasItems);
}

// ============================================================
//  MOBILE NAV (mirrors index.php)
// ============================================================
const hamburgerBtn = document.getElementById('hamburgerBtn');
const mobileNav    = document.getElementById('mobileNav');

hamburgerBtn?.addEventListener('click', () => {
    const open = mobileNav.classList.toggle('open');
    hamburgerBtn.setAttribute('aria-expanded', String(open));
});

document.querySelectorAll('.mobile-parent').forEach(link => {
    link.addEventListener('click', e => {
        e.preventDefault();
        const item = link.closest('.mobile-nav-item');
        item.classList.toggle('open');
        item.parentElement.querySelectorAll('.mobile-nav-item').forEach(s => {
            if (s !== item) s.classList.remove('open');
        });
    });
});

document.querySelectorAll('.mobile-submenu a, .mobile-simple').forEach(a => {
    a.addEventListener('click', () => {
        mobileNav.classList.remove('open');
        hamburgerBtn?.setAttribute('aria-expanded', 'false');
    });
});

// ============================================================
//  INIT
// ============================================================
applyTransform();
updateDropHint();
</script>
</body>
</html>
