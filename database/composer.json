{
    "name": "backstage/users-module",
    "description": "PHP 8.1 CRUD module for the Backstage 2.0 users table (PostgreSQL)",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Backstage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Backstage\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
